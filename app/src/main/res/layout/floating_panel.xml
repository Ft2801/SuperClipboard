<?xml version="1.0" encoding="utf-8"?>
<!-- res/layout/floating_panel.xml -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/floating_panel_root"
    android:layout_width="320dp"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/panel_background"
    android:elevation="8dp"
    android:padding="0dp"
    android:maxHeight="450dp">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="16dp"
        android:background="@drawable/panel_header_background">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_clipboard"
            android:contentDescription="SuperClipboard" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="SuperClipboard"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:layout_marginStart="12dp" />

        <ImageView
            android:id="@+id/btn_close_panel"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:padding="4dp"
            android:src="@android:drawable/ic_menu_close_clear_cancel"
            android:contentDescription="Close"
            android:background="?android:attr/selectableItemBackgroundBorderless" />
    </LinearLayout>

    <!-- Saved texts list -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recycler_saved_texts"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:maxHeight="350dp"
        android:padding="8dp"
        android:clipToPadding="false" />

    <!-- Empty state -->
    <TextView
        android:id="@+id/tv_empty_state"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="No saved texts.\nOpen SuperClipboard to add some."
        android:textAlignment="center"
        android:textColor="#666666"
        android:padding="32dp"
        android:visibility="gone" />

    <!-- Injection progress -->
    <LinearLayout
        android:id="@+id/injection_progress_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/tv_injection_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Injecting massive text..."
            android:textColor="#6750A4"
            android:textStyle="bold"
            android:textSize="14sp" />

        <ProgressBar
            android:id="@+id/progress_injection"
            style="@android:style/Widget.ProgressBar.Horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:max="100"
            android:progress="0" />

        <TextView
            android:id="@+id/tv_injection_detail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="0%"
            android:textSize="12sp"
            android:textColor="#888888"
            android:layout_marginTop="4dp" />
    </LinearLayout>

</LinearLayout>